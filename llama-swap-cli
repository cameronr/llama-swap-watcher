#!/usr/bin/env bash
set -euo pipefail

URL=${LLAMA_SWAP_URL:-http://localhost:8020}
PROFILE_DESKTOP=vllm-3090
PROFILE_HEADLESS=vllm-dual
POLL=${LLAMA_SWAP_POLL:-2}
RETRY=10
API_CODE=""
API_BODY=""

api() {
  local method=$1 path=$2 body=${3-}
  local args=(-s -w $'\n%{http_code}' -X "$method")
  if [[ -n $body ]]; then
    args+=(-H 'Content-Type: application/json' -d "$body")
  fi
  if [[ -n ${LLAMA_SWAP_API_KEY-} ]]; then
    args+=(-H "Authorization: Bearer $LLAMA_SWAP_API_KEY")
  fi
  local resp
  if ! resp=$(curl "${args[@]}" "$URL$path" 2>/dev/null); then
    API_CODE=""
    API_BODY=""
    printf 'llama-swap-cli: cannot reach llama-swap at %s\n' "$URL" >&2
    return 1
  fi
  API_CODE=${resp##*$'\n'}
  API_BODY=${resp%$'\n'*}
  printf '%s\n' "$API_BODY"
  [[ $API_CODE == 2* ]]
}

# Stop every loaded model (POST /api/models/unload). Called after a switch to
# the desktop profile so the 3090 keeps its VRAM free for hyprland. Blocks
# until the daemon has stopped the processes (docker stop), so it can take a
# few seconds. Best effort: a failure here never undoes the profile switch.
unload_all() {
  if ! api POST /api/models/unload >/dev/null; then
    # no http code means the daemon is unreachable and api() already reported it
    if [[ -n $API_CODE ]]; then
      printf 'llama-swap-cli: failed to unload models: http %s\n' "$API_CODE" >&2
    fi
    return 1
  fi
  printf 'llama-swap-cli: unloaded all models\n'
}

# set_profile NAME [quiet]: no-op when NAME is already active, and silent
# when quiet, so the watcher can call it every poll without log noise.
set_profile() {
  local name=$1 quiet=${2-}
  local json active new
  json=$(api GET /api/profiles) || return 1
  active=$(jq -r .active <<<"$json")
  if [[ $active == "$name" ]]; then
    [[ -n $quiet ]] || printf 'llama-swap-cli: %s is already active\n' "$name"
    return 0
  fi
  # in the current shell, not $( ), so API_CODE/API_BODY survive the call
  api PUT /api/profiles/active "{\"name\":\"$name\"}" >/dev/null || :
  if [[ $API_CODE == 2* ]]; then
    new=$(jq -r .active <<<"$API_BODY")
    [[ $new == "$name" ]] || return 1
    printf 'llama-swap-cli: active profile set to %s\n' "$name"
    if [[ $name == "$PROFILE_DESKTOP" ]]; then
      # desktop profile: free the 3090's VRAM for hyprland (best effort)
      unload_all || :
    fi
  elif [[ $API_CODE == 404 ]]; then
    printf "llama-swap-cli: unknown profile '%s'\n" "$name" >&2
    jq -r '.profiles | map(.id) | join(", ")' <<<"$json" >&2
    return 1
  elif [[ -n $API_CODE ]]; then
    printf '%s\n' "$API_BODY" >&2
    return 1
  else
    # no response at all; api already printed the connection failure
    return 1
  fi
}

cmd_list() {
  local json
  json=$(api GET /api/profiles) || exit 1
  jq -r '
    .active as $active
    | .profiles[]
    | ((if .id == $active then "* " else "  " end) + .id)
      + (if (.description // "") != "" then "\n  # " + .description else "" end)
  ' <<<"$json"
}

cmd_set() {
  local name=${1-}
  if ! [[ $name =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf 'usage: llama-swap-cli set <name>\n' >&2
    exit 2
  fi
  set_profile "$name" || exit 1
}

cmd_unload() {
  unload_all || exit 1
}

# Count GPUs the host nvidia driver is bound to. One /dev/nvidiaN node per
# bound GPU, and the driver removes the node when a GPU is unbound, e.g. when
# it is passed through to a VM. A glob count avoids an nvidia-smi spawn and
# parsing its output every poll.
gpu_count() {
  local n=0 d
  for d in /dev/nvidia[0-9]*; do
    # n=$((n+1)), not ((n++)): the latter exits 1 when n is 0 and set -e would kill us
    [[ -e $d ]] && n=$((n+1))
  done
  printf '%d\n' "$n"
}

# Every poll, not just on sddm transitions: a daemon restart can drop the
# active profile to none, and a stale last would keep the watcher from
# noticing that. set_profile is a no-op when the profile already matches, so
# the steady state is one cheap GET per poll and zero writes.
# Desktop profile when sddm runs, or when only one GPU is bound to the host
# (the 4090 passed through to a VM, leaving the 3090 alone), so vllm does not
# try to run the dual profile on a GPU that is not there.
watch() {
  local st gpus target last=""
  while :; do
    st=$(systemctl is-active sddm 2>/dev/null || true)
    gpus=$(gpu_count)
    if (( gpus == 1 )) || [[ $st == active || $st == activating ]]; then
      target=$PROFILE_DESKTOP
    else
      target=$PROFILE_HEADLESS
    fi
    if [[ $target != "$last" ]]; then
      last=$target
      printf 'llama-swap-cli: sddm=%s gpus=%d, target %s\n' "$st" "$gpus" "$target"
    fi
    if set_profile "$target" quiet; then
      sleep $POLL
    else
      # daemon down or a failed set; slower cadence so the journal does not flood
      sleep $RETRY
    fi
  done
}

usage() {
  cat >&2 <<'EOF'
usage: llama-swap-cli <command>

  list   list profiles, mark the active one
  set    set the active profile
  unload stop all loaded models (frees GPU VRAM)
  watch  keep the profile in sync with sddm (used by the systemd service)

env: LLAMA_SWAP_URL, LLAMA_SWAP_API_KEY, LLAMA_SWAP_POLL
EOF
}

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi
case $1 in
  list) cmd_list ;;
  set) cmd_set "${2-}" ;;
  unload) cmd_unload ;;
  watch) watch ;;
  -h|--help) usage; exit 0 ;;
  *) usage; exit 1 ;;
esac
